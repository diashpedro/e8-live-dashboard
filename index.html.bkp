<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Painel ao vivo — DAYTRADE</title>
<style>
  :root{
    --bg:#0d1117; --bg-panel:#12181f; --bg-panel-2:#171f28; --border:#232c37;
    --text:#dfe6ee; --text-dim:#7c8894; --accent:#d8a84b;
    --green:#3fb87f; --red:#e2596b; --amber:#d8a84b;
  }
  @media (prefers-color-scheme: light){
    :root{
      --bg:#f5f3ee; --bg-panel:#fff; --bg-panel-2:#faf8f3; --border:#e2ddd0;
      --text:#21262c; --text-dim:#6b7280; --accent:#a97a1f;
      --green:#1f8a5c; --red:#c2333f; --amber:#a97a1f;
    }
  }
  :root[data-theme="dark"]{
    --bg:#0d1117; --bg-panel:#12181f; --bg-panel-2:#171f28; --border:#232c37;
    --text:#dfe6ee; --text-dim:#7c8894; --accent:#d8a84b;
    --green:#3fb87f; --red:#e2596b; --amber:#d8a84b;
  }
  :root[data-theme="light"]{
    --bg:#f5f3ee; --bg-panel:#fff; --bg-panel-2:#faf8f3; --border:#e2ddd0;
    --text:#21262c; --text-dim:#6b7280; --accent:#a97a1f;
    --green:#1f8a5c; --red:#c2333f; --amber:#a97a1f;
  }
  *{ box-sizing:border-box; }
  body{ margin:0; background:var(--bg); color:var(--text);
        font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
        -webkit-font-smoothing:antialiased; }
  .num{ font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
        font-variant-numeric:tabular-nums; }

  header{ padding:24px clamp(16px,4vw,48px) 18px; border-bottom:1px solid var(--border);
          display:flex; align-items:baseline; justify-content:space-between; gap:14px; flex-wrap:wrap; }
  header h1{ margin:0; font-size:1.1rem; font-weight:650; }
  header h1 span{ color:var(--accent); }
  #updated{ font-size:.78rem; color:var(--text-dim); }

  main{ max-width:1180px; margin:0 auto; padding:22px clamp(16px,4vw,48px) 64px; }

  /* ---- faixa de saude ---- */
  .health{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:22px; }
  .chip{ display:inline-flex; align-items:center; gap:7px; padding:7px 13px;
         background:var(--bg-panel); border:1px solid var(--border); border-radius:999px;
         font-size:.79rem; }
  .dot{ width:8px; height:8px; border-radius:50%; flex:none; }
  .dot.ok{ background:var(--green); box-shadow:0 0 6px var(--green); }
  .dot.bad{ background:var(--red); box-shadow:0 0 6px var(--red); }
  .dot.warn{ background:var(--amber); box-shadow:0 0 6px var(--amber); }

  .cards{ display:grid; grid-template-columns:repeat(auto-fit,minmax(196px,1fr)); gap:12px; margin-bottom:22px; }
  .card{ background:var(--bg-panel); border:1px solid var(--border); border-radius:10px; padding:16px 18px; }
  .card .label{ font-size:.7rem; text-transform:uppercase; letter-spacing:.07em; color:var(--text-dim); margin-bottom:7px; }
  .card .value{ font-size:1.5rem; font-weight:650; }
  .card .sub{ font-size:.75rem; color:var(--text-dim); margin-top:5px; }
  .pos{ color:var(--green); } .neg{ color:var(--red); }

  .panel{ background:var(--bg-panel); border:1px solid var(--border); border-radius:10px;
          margin-bottom:20px; overflow:hidden; }
  .panel-head{ padding:13px 18px; border-bottom:1px solid var(--border); font-size:.78rem;
               font-weight:600; color:var(--text-dim); text-transform:uppercase; letter-spacing:.06em;
               display:flex; justify-content:space-between; align-items:center; gap:10px; }
  .panel-head .hint{ text-transform:none; letter-spacing:0; font-weight:400; font-size:.75rem; }

  #chart-wrap{ padding:14px 18px 6px; overflow-x:auto; }
  #chart{ display:block; width:100%; height:160px; }

  .table-wrap{ overflow-x:auto; }
  table{ width:100%; border-collapse:collapse; font-size:.845rem; }
  thead th{ text-align:left; padding:9px 14px; font-size:.68rem; text-transform:uppercase;
            letter-spacing:.06em; color:var(--text-dim); border-bottom:1px solid var(--border);
            background:var(--bg-panel-2); white-space:nowrap; }
  tbody td{ padding:8px 14px; border-bottom:1px solid var(--border); white-space:nowrap; }
  tbody tr:last-child td{ border-bottom:none; }
  tbody tr:hover{ background:var(--bg-panel-2); }
  th.r, td.r{ text-align:right; }

  .badge{ display:inline-block; padding:1px 7px; border-radius:5px; font-size:.76rem;
          background:var(--bg-panel-2); border:1px solid var(--border); }
  .badge.w{ color:var(--accent); }
  .side-long{ color:var(--green); } .side-short{ color:var(--red); }
  .empty{ padding:28px 18px; text-align:center; color:var(--text-dim); font-size:.85rem; }

  .grid2{ display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:20px; }
  .grid2 .panel{ margin-bottom:0; }

  footer{ text-align:center; padding:18px; color:var(--text-dim); font-size:.73rem; }

  .tabs{ display:flex; gap:6px; }
  .tab{ padding:7px 15px; border-radius:8px; border:1px solid var(--border); background:var(--bg-panel);
        color:var(--text-dim); font-size:.82rem; font-weight:600; cursor:pointer; }
  .tab.active{ background:var(--accent); color:#1a1509; border-color:var(--accent); }
  .hidden{ display:none !important; }
</style>
</head>
<body>

<header>
  <h1 id="title">Estratégia <span>8</span> — painel ao vivo</h1>
  <div class="tabs" id="tabs">
    <button class="tab" data-src="e8">Estratégia 8</button>
    <button class="tab" data-src="win">Portfólio WIN</button>
    <button class="tab" data-src="brooks">Brooks</button>
  </div>
  <div id="updated">carregando…</div>
</header>

<main>
  <div class="health" id="health"></div>

  <div class="cards" id="cards"></div>

  <div class="panel">
    <div class="panel-head">
      <span>Posições em andamento</span>
      <span class="hint" id="open-sub"></span>
    </div>
    <div class="table-wrap">
      <table id="open-table">
        <thead id="open-head"></thead>
        <tbody id="open-body"></tbody>
      </table>
      <div class="empty" id="open-empty" style="display:none;">Nenhuma posição aberta agora.</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><span>Resultado acumulado</span><span class="hint">apenas trades encerrados</span></div>
    <div id="chart-wrap"><canvas id="chart"></canvas></div>
  </div>

  <div class="panel">
    <div class="panel-head"><span>Histórico por dia</span></div>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th>Data</th><th class="r">Trades</th><th class="r">Acertos</th>
          <th class="r">Taxa</th><th class="r">Resultado</th><th class="r">Acumulado</th>
        </tr></thead>
        <tbody id="daily-body"></tbody>
      </table>
      <div class="empty" id="daily-empty" style="display:none;">Nenhum dia encerrado ainda.</div>
    </div>
  </div>

  <div class="grid2">
    <div class="panel">
      <div class="panel-head"><span id="bygroup1-title">Por janela (W)</span></div>
      <div class="table-wrap"><table>
        <thead><tr><th id="bygroup1-col">W</th><th class="r">Trades</th><th class="r">Taxa</th><th class="r">Resultado</th></tr></thead>
        <tbody id="bygroup1-body"></tbody>
      </table></div>
    </div>
    <div class="panel">
      <div class="panel-head"><span>Por ativo</span></div>
      <div class="table-wrap"><table>
        <thead><tr><th>Ativo</th><th class="r">Trades</th><th class="r">Taxa</th><th class="r">Resultado</th></tr></thead>
        <tbody id="bysymbol-body"></tbody>
      </table></div>
    </div>
    <div class="panel" id="byleg-panel">
      <div class="panel-head"><span id="byleg-title">Por perna</span><span class="hint" id="byleg-hint">a pirâmide paga?</span></div>
      <div class="table-wrap"><table>
        <thead><tr><th id="byleg-col">Perna</th><th class="r">Trades</th><th class="r">Taxa</th><th class="r">Resultado</th></tr></thead>
        <tbody id="byleg-body"></tbody>
      </table></div>
    </div>
    <div class="panel">
      <div class="panel-head"><span>Por motivo de saída</span></div>
      <div class="table-wrap"><table>
        <thead><tr><th>Motivo</th><th class="r">Trades</th><th class="r">Resultado</th></tr></thead>
        <tbody id="byreason-body"></tbody>
      </table></div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">
      <span>Trades encerrados</span>
      <span class="hint" id="trades-sub"></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead id="trades-head"></thead>
        <tbody id="trades-body"></tbody>
      </table>
      <div class="empty" id="trades-empty" style="display:none;">Nenhum trade encerrado ainda.</div>
    </div>
  </div>
</main>

<footer>
  <span id="footer-desc">Estratégia 8 · 5 janelas × 2 direções, pernas A/B/C · conta demo B3 · atualiza sozinho a cada 3 min</span>
  <div id="start-note" style="margin-top:6px"></div>
</footer>

<script>
const BRL = new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
const money = v => BRL.format(v ?? 0);
const price = v => (v ?? 0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
const qty   = v => (v ?? 0).toLocaleString('pt-BR');
const pct   = v => (v ?? 0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}) + '%';
const cls   = v => v > 0 ? 'pos' : (v < 0 ? 'neg' : '');

function hhmm(iso){ if(!iso) return '—'; const d=new Date(iso); return isNaN(d)?iso:
  d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}); }
function dm(iso){ if(!iso) return '—'; const d=new Date(iso+(iso.length===10?'T12:00:00':''));
  return isNaN(d)?iso:d.toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit'}); }
function dmhm(iso){ if(!iso) return '—'; const d=new Date(iso); return isNaN(d)?iso:
  d.toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}); }
function dur(min){
  if(min == null) return '—';
  if(min < 60) return Math.round(min)+' min';
  const h = Math.floor(min/60), m = Math.round(min%60);
  return h+'h'+(m?String(m).padStart(2,'0'):'');
}
function taxa(w,t){ return t ? (100*w/t).toLocaleString('pt-BR',{maximumFractionDigits:0})+'%' : '—'; }

function chip(state, text){
  return `<span class="chip"><span class="dot ${state}"></span>${text}</span>`;
}

function renderHealth(d){
  const h = d.health || {}, a = d.account || {};
  const out = [];
  const upd = d.updated_at ? new Date(d.updated_at) : null;
  const mins = upd ? (Date.now() - upd.getTime())/60000 : 999;
  out.push(chip(mins < 8 ? 'ok' : (mins < 20 ? 'warn' : 'bad'),
    mins < 8 ? 'Dados atualizados' : `Sem atualizar há ${Math.round(mins)} min`));
  out.push(chip(h.terminal_connected ? 'ok' : 'bad',
    h.terminal_connected ? 'Terminal conectado' : 'Terminal DESCONECTADO'));
  out.push(chip(h.algo_trading ? 'ok' : 'bad',
    h.algo_trading ? 'AlgoTrading ligado' : 'AlgoTrading DESLIGADO'));
  out.push(chip((h.errors_today||0) === 0 ? 'ok' : 'bad',
    (h.errors_today||0) === 0 ? 'Sem erros hoje' : `${h.errors_today} erro(s) hoje`));
  if(h.last_ea_event) out.push(chip('ok', 'Último evento do robô: ' + hhmm(h.last_ea_event)));
  out.push(chip('ok', `${h.pendentes||0} ordem(ns) pendente(s)`));
  const bad = (h.symbols||[]).filter(s=>!s.ok);
  if(bad.length) out.push(chip('bad', 'Sem cotação: ' + bad.map(s=>s.symbol).join(', ')));
  if(a.login) out.push(chip('ok', `Conta ${a.login} · saldo ${money(a.balance)}`));
  document.getElementById('health').innerHTML = out.join('');
}

function renderCards(d){
  const t = d.today || {}, c = d.cumulative || {};
  const cards = [
    { label:'Resultado do dia (realizado)', value:money(t.realized), cls:cls(t.realized),
      sub:`${t.trades||0} trade(s) · ${t.wins||0} ganhador(es)` +
          (t.broker_realized != null && Math.abs((t.broker_realized||0)-(t.realized||0)) > 0.01
            ? ` · caixa na corretora ${money(t.broker_realized)}` : '') },
    { label:'Em aberto (não realizado)', value:money(t.unrealized), cls:cls(t.unrealized),
      sub:`${t.open_legs||0} perna(s) · exposição ${money(t.exposure)}` },
    { label:'Total do dia', value:money(t.total), cls:cls(t.total),
      sub:'realizado + em aberto' },
    { label:'Acumulado', value:money(c.pnl), cls:cls(c.pnl),
      sub:c.since ? `desde ${dm(c.since)} · ${c.trades||0} trades` : '—' },
    { label:'Taxa de acerto', value: c.trades ? taxa(c.wins,c.trades) : '—', cls:'',
      sub:c.trades ? `${c.wins} de ${c.trades}` : '—' },
    { label:'Dias positivos', value: c.days ? `${c.days_positive}/${c.days}` : '—', cls:'',
      sub: c.best_day ? `melhor ${money(c.best_day.pnl)} · pior ${money(c.worst_day.pnl)}` : '—' },
  ];
  document.getElementById('cards').innerHTML = cards.map(c=>`
    <div class="card">
      <div class="label">${c.label}</div>
      <div class="value num ${c.cls}">${c.value}</div>
      <div class="sub">${c.sub}</div>
    </div>`).join('');
}

const OPEN_HEAD = {
  legged: `<tr><th>Ativo</th><th>Janela</th><th>Perna</th><th>Lado</th><th>Aberta às</th>
    <th class="r">Tempo</th><th class="r">Preço entrada</th><th class="r">Preço atual</th>
    <th class="r">Qtd</th><th class="r">Valor da posição</th><th class="r">Resultado</th><th class="r">%</th></tr>`,
  strategy: `<tr><th>Ativo</th><th>Estratégia</th><th>Lado</th><th>Aberta às</th>
    <th class="r">Tempo</th><th class="r">Preço entrada</th><th class="r">Preço atual</th>
    <th class="r">Qtd</th><th class="r">Valor da posição</th><th class="r">Resultado</th><th class="r">%</th></tr>`,
  brooks: `<tr><th>Ativo</th><th>Setup</th><th>Gaveta</th><th>Lado</th><th>Aberta às</th>
    <th class="r">Tempo</th><th class="r">Preço entrada</th><th class="r">Preço atual</th>
    <th class="r">Qtd</th><th class="r">Valor da posição</th><th class="r">Resultado</th><th class="r">%</th></tr>`,
};
const TRADES_HEAD = {
  legged: `<tr><th>Ativo</th><th>Janela</th><th>Perna</th><th>Lado</th>
    <th>Entrada</th><th>Saída</th><th class="r">Tempo</th>
    <th class="r">Preço entrada</th><th class="r">Preço saída</th>
    <th class="r">Qtd</th><th>Motivo</th><th class="r">Resultado</th></tr>`,
  strategy: `<tr><th>Ativo</th><th>Estratégia</th><th>Lado</th>
    <th>Entrada</th><th>Saída</th><th class="r">Tempo</th>
    <th class="r">Preço entrada</th><th class="r">Preço saída</th>
    <th class="r">Qtd</th><th>Motivo</th><th class="r">Resultado</th></tr>`,
  brooks: `<tr><th>Ativo</th><th>Setup</th><th>Gaveta</th><th>Lado</th>
    <th>Entrada</th><th>Saída</th><th class="r">Tempo</th>
    <th class="r">Preço entrada</th><th class="r">Preço saída</th>
    <th class="r">Qtd</th><th>Motivo</th><th class="r">Resultado</th></tr>`,
};

function idCell(mode, r){
  if(mode === 'legged')
    return `<td><span class="badge w num">W${r.w}</span></td><td><span class="badge">${r.leg}</span></td>`;
  // No Brooks a identidade tem dois niveis: o SETUP diz qual padrao do livro
  // disparou, a GAVETA diz qual das variacoes de parametro dele foi. Sem os
  // dois nao da para saber se um setup paga ou se e uma gaveta sortuda dentro
  // dele -- que e a pergunta que 154 gavetas obrigam a fazer.
  if(mode === 'brooks')
    return `<td><span class="badge w">${r.setup || '?'}</span></td>`
         + `<td><span class="badge num">${r.gaveta}</span></td>`;
  return `<td><span class="badge w">${r.strategy_label || r.strategy}</span></td>`;
}

function renderOpen(d, mode){
  document.getElementById('open-head').innerHTML = OPEN_HEAD[mode];
  const rows = d.open_positions || [];
  const body = document.getElementById('open-body');
  const total = rows.reduce((s,r)=>s+r.pnl,0);
  document.getElementById('open-sub').textContent =
    rows.length ? `${rows.length} posição(ões) · resultado ${money(total)}` : '';
  document.getElementById('open-empty').style.display = rows.length ? 'none' : 'block';
  body.innerHTML = rows.map(r=>`
    <tr>
      <td>${r.symbol}</td>
      ${idCell(mode, r)}
      <td class="${r.side==='LONG'?'side-long':'side-short'}">${r.side==='LONG'?'Compra':'Venda'}</td>
      <td class="num">${hhmm(r.entry_time)}</td>
      <td class="num r">${dur(r.minutos)}</td>
      <td class="num r">${price(r.entry_price)}</td>
      <td class="num r">${price(r.current_price)}</td>
      <td class="num r">${qty(r.qty)}</td>
      <td class="num r">${money(r.notional)}</td>
      <td class="num r ${cls(r.pnl)}">${money(r.pnl)}</td>
      <td class="num r ${cls(r.pnl)}">${pct(r.pnl_pct)}</td>
    </tr>`).join('');
}

function renderDaily(d){
  const rows = (d.daily_series||[]).slice().reverse();
  document.getElementById('daily-empty').style.display = rows.length ? 'none' : 'block';
  document.getElementById('daily-body').innerHTML = rows.map(r=>`
    <tr>
      <td class="num">${dm(r.date)}</td>
      <td class="num r">${r.trades}</td>
      <td class="num r">${r.wins}</td>
      <td class="num r">${taxa(r.wins,r.trades)}</td>
      <td class="num r ${cls(r.pnl)}">${money(r.pnl)}</td>
      <td class="num r ${cls(r.cum)}">${money(r.cum)}</td>
    </tr>`).join('');
}

function renderTrades(d, mode){
  document.getElementById('trades-head').innerHTML = TRADES_HEAD[mode];
  const rows = d.trades || [];
  document.getElementById('trades-sub').textContent = rows.length ? `${rows.length} no total` : '';
  document.getElementById('trades-empty').style.display = rows.length ? 'none' : 'block';
  document.getElementById('trades-body').innerHTML = rows.map(r=>`
    <tr>
      <td>${r.symbol}</td>
      ${idCell(mode, r)}
      <td class="${r.side==='LONG'?'side-long':'side-short'}">${r.side==='LONG'?'Compra':'Venda'}</td>
      <td class="num">${dmhm(r.entry_time)}</td>
      <td class="num">${hhmm(r.exit_time)}</td>
      <td class="num r">${dur(r.minutos)}</td>
      <td class="num r">${price(r.entry_price)}</td>
      <td class="num r">${price(r.exit_price)}</td>
      <td class="num r">${qty(r.qty)}</td>
      <td>${r.motivo_label || r.motivo || '—'}</td>
      <td class="num r ${cls(r.pnl)}">${money(r.pnl)}</td>
    </tr>`).join('');
}

function renderBreakdowns(d, mode){
  const fill = (id, rows, key, label) => {
    const el = document.getElementById(id);
    if(!rows || !rows.length){ el.innerHTML = `<tr><td colspan="4" style="color:var(--text-dim)">sem dados</td></tr>`; return; }
    el.innerHTML = rows.map(r=>`
      <tr>
        <td>${label ? label(r[key]) : r[key]}</td>
        <td class="num r">${r.trades}</td>
        ${'wins' in r ? `<td class="num r">${taxa(r.wins,r.trades)}</td>` : ''}
        <td class="num r ${cls(r.pnl)}">${money(r.pnl)}</td>
      </tr>`).join('');
  };
  document.getElementById('byleg-panel').classList.toggle('hidden',
    mode !== 'legged' && mode !== 'brooks');
  if(mode === 'legged'){
    document.getElementById('bygroup1-title').textContent = 'Por janela (W)';
    document.getElementById('bygroup1-col').textContent = 'W';
    document.getElementById('byleg-title').textContent = 'Por perna';
    document.getElementById('byleg-hint').textContent = 'a pirâmide paga?';
    document.getElementById('byleg-col').textContent = 'Perna';
    fill('bygroup1-body', d.by_window, 'w', v=>`<span class="badge w num">W${v}</span>`);
    fill('byleg-body', d.by_leg, 'leg', v=>`<span class="badge">${v}</span>`);
  } else if(mode === 'brooks'){
    // Livro em cima, setup embaixo: e a hierarquia do proprio Brooks (Trends,
    // Trading Ranges, Reversals) e responde primeiro qual REGIME esta pagando,
    // depois qual padrao dentro dele.
    document.getElementById('bygroup1-title').textContent = 'Por livro';
    document.getElementById('bygroup1-col').textContent = 'Livro';
    document.getElementById('byleg-title').textContent = 'Por setup';
    document.getElementById('byleg-hint').textContent = 'quais dos 29 pagam?';
    document.getElementById('byleg-col').textContent = 'Setup';
    fill('bygroup1-body', d.by_livro, 'livro', v=>`<span class="badge w">${v}</span>`);
    fill('byleg-body', d.by_setup, 'setup', v=>`<span class="badge">${v}</span>`);
  } else {
    document.getElementById('bygroup1-title').textContent = 'Por estratégia';
    document.getElementById('bygroup1-col').textContent = 'Estratégia';
    fill('bygroup1-body', d.by_strategy, 'strategy', v=>`<span class="badge w">${v}</span>`);
  }
  fill('bysymbol-body', d.by_symbol, 'symbol');
  // motivo nao tem coluna de taxa
  const el = document.getElementById('byreason-body');
  const rows = d.by_reason || [];
  el.innerHTML = rows.length ? rows.map(r=>`
      <tr><td>${r.reason}</td><td class="num r">${r.trades}</td>
      <td class="num r ${cls(r.pnl)}">${money(r.pnl)}</td></tr>`).join('')
    : `<tr><td colspan="3" style="color:var(--text-dim)">sem dados</td></tr>`;
}

function drawChart(series){
  const canvas = document.getElementById('chart'), wrap = document.getElementById('chart-wrap');
  const dpr = window.devicePixelRatio || 1;
  const W = Math.max(wrap.clientWidth, 320), H = 160;
  canvas.width = W*dpr; canvas.height = H*dpr;
  canvas.style.width = W+'px'; canvas.style.height = H+'px';
  const ctx = canvas.getContext('2d'); ctx.scale(dpr,dpr); ctx.clearRect(0,0,W,H);
  const st = getComputedStyle(document.documentElement);
  const cG = st.getPropertyValue('--green').trim(), cR = st.getPropertyValue('--red').trim();
  const cB = st.getPropertyValue('--border').trim(), cD = st.getPropertyValue('--text-dim').trim();

  if(!series || !series.length){
    ctx.fillStyle = cD; ctx.font = '13px sans-serif';
    ctx.fillText('Sem trades encerrados ainda', 16, H/2); return;
  }
  const padL=8,padR=8,padT=14,padB=20;
  const cum = series.map(d=>d.cum);
  const maxV = Math.max(0,...cum), minV = Math.min(0,...cum), range=(maxV-minV)||1;
  const pw = W-padL-padR, ph = H-padT-padB;
  const x = i => padL + (series.length===1 ? pw/2 : (i/(series.length-1))*pw);
  const y = v => padT + ph - ((v-minV)/range)*ph;

  const zy = y(0);
  ctx.strokeStyle=cB; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(padL,zy); ctx.lineTo(W-padR,zy); ctx.stroke();

  ctx.beginPath();
  cum.forEach((v,i)=>{ i? ctx.lineTo(x(i),y(v)) : ctx.moveTo(x(i),y(v)); });
  const last = cum[cum.length-1], col = last>=0 ? cG : cR;
  ctx.strokeStyle=col; ctx.lineWidth=2; ctx.lineJoin='round'; ctx.stroke();
  ctx.lineTo(x(cum.length-1),zy); ctx.lineTo(x(0),zy); ctx.closePath();
  ctx.fillStyle = col+'22'; ctx.fill();
  ctx.beginPath(); ctx.arc(x(cum.length-1),y(last),3.5,0,Math.PI*2); ctx.fillStyle=col; ctx.fill();

  ctx.fillStyle=cD; ctx.font='11px sans-serif';
  ctx.textAlign='left';  ctx.fillText(dm(series[0].date), padL, H-4);
  ctx.textAlign='right'; ctx.fillText(dm(series[series.length-1].date), W-padR, H-4);
}

const SOURCES = {
  e8: {
    file: 'data.json', mode: 'legged', title: 'Estratégia <span>8</span> — painel ao vivo',
    footer: 'Estratégia 8 · 5 janelas × 2 direções, pernas A/B/C · conta demo B3 · atualiza sozinho a cada 3 min',
  },
  win: {
    file: 'data_win.json', mode: 'strategy', title: 'Portfólio <span>WIN</span> — painel ao vivo',
    footer: 'VolBreak + VWAP + ORB · 1 EA, 3 módulos, magic único · WIN futuro, conta demo B3 · atualiza sozinho a cada 3 min',
  },
  brooks: {
    file: 'data_brooks.json', mode: 'brooks', title: 'Al <span>Brooks</span> — painel ao vivo',
    footer: '154 gavetas · 29 setups dos 3 livros · sinal em M15 na série contínua, ordem no contrato · WIN futuro, conta demo B3 · atualiza sozinho a cada 3 min',
  },
};
let currentSrc = 'e8';
let ultimo = null;

function render(d, mode){
  ultimo = d;
  document.getElementById('updated').textContent = d.updated_at
    ? 'atualizado ' + dmhm(d.updated_at) : 'aguardando primeira atualização';
  document.getElementById('start-note').textContent = d.start_date
    ? `Contagem iniciada em ${dm(d.start_date)} — pregões anteriores (fase de depuração) não entram no resultado.`
    : '';
  renderHealth(d); renderCards(d); renderOpen(d, mode);
  drawChart(d.daily_series||[]);
  renderDaily(d); renderTrades(d, mode); renderBreakdowns(d, mode);
}

async function load(){
  const src = SOURCES[currentSrc];
  try{
    const r = await fetch(src.file+'?_='+Date.now());
    if(!r.ok) throw new Error('HTTP '+r.status);
    render(await r.json(), src.mode);
  }catch(e){
    document.getElementById('updated').textContent = 'erro ao carregar dados';
    console.error(e);
  }
}

function selectSource(key){
  currentSrc = key;
  const src = SOURCES[key];
  document.getElementById('title').innerHTML = src.title;
  document.getElementById('footer-desc').textContent = src.footer;
  document.querySelectorAll('.tab').forEach(b => b.classList.toggle('active', b.dataset.src === key));
  document.getElementById('updated').textContent = 'carregando…';
  load();
}

document.querySelectorAll('.tab').forEach(b => b.addEventListener('click', () => selectSource(b.dataset.src)));
selectSource('e8');
setInterval(load, 60000);
window.addEventListener('resize', ()=>{ if(ultimo) drawChart(ultimo.daily_series||[]); });
</script>
</body>
</html>
